          {
            "state": "CRYSTAL",
            "operator": ">=",
            "value": 1
          }
        ]
      }
    ]
  },
  "initial_state": [
    ["EMPTY", "EMPTY", "EMPTY", "EMPTY", "EMPTY"],
    ["EMPTY", "EMPTY", "EMPTY", "EMPTY", "EMPTY"],
    ["EMPTY", "EMPTY", "CRYSTAL", "EMPTY", "EMPTY"],
    ["EMPTY", "EMPTY", "EMPTY", "EMPTY", "EMPTY"],
    ["EMPTY", "EMPTY", "EMPTY", "EMPTY", "EMPTY"]
  ]
}
