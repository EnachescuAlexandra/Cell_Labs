
{
  "automaton": {
    "name": "Crystal Growth",
    "width": 5,
    "height": 5,
    "states": ["EMPTY", "CRYSTAL"],
    "neighborhood": "moore",
    "boundary": "fixed",
    "default": "keep",
    "rules": [
      {
        "from": "EMPTY",
        "to": "CRYSTAL",
